          <mxGeometry x="20" y="10" width="1000" height="36" as="geometry" />
        </mxCell>
        <mxCell id="f1-2" value="Màu cho biết mức độ đã có trong code: xanh = đã làm, cam = làm một phần, xám nét đứt = chưa làm. SRS tách ba kết quả: tạo kho ≠ thanh toán ≠ kích hoạt." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="20" y="46" width="1200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="f1-3" value="Người dùng đăng nhập&lt;br&gt;(email đã xác minh / Google)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="100" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="f1-4" value="&lt;b&gt;1. “Tạo kho của tôi”&lt;/b&gt;&lt;br&gt;Vault OPEN + quyền dịch vụ FREE 20 MiB + kế hoạch DRAFT&lt;br&gt;(SETUP-12: mỗi Owner một kho)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="300" y="210" width="340" height="80" as="geometry" />
        </mxCell>
        <mxCell id="f1-5" value="&lt;b&gt;2. Dùng hạng Free&lt;/b&gt;&lt;br&gt;✔ Upload, xem, tải tài sản trong 20 MiB&lt;br&gt;✘ Tạo Container rỗng (SETUP-17)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="300" y="330" width="340" height="80" as="geometry" />
        </mxCell>
        <mxCell id="f1-6" value="&lt;b&gt;3. “Thiết lập bàn giao”&lt;/b&gt;&lt;br&gt;Đồng ý xử lý dữ liệu + eKYC OWNER_ENROLLMENT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="450" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="f1-7" value="eKYC đạt&lt;br&gt;(còn trong 90 ngày,&lt;br&gt;EKYC-28)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="560" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="f1-8" value="Giữ kho Free;&lt;br&gt;thử lại hoặc nhận hỗ trợ&lt;br&gt;(không ai duyệt thay)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="580" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="f1-9" value="&lt;b&gt;4. Mua dịch vụ&lt;/b&gt;&lt;br&gt;Chọn XS / XS Max, kỳ 1/3/5 năm, số suất thêm&lt;br&gt;→ đơn PENDING → QR SePay → webhook" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="710" width="340" height="80" as="geometry" />
        </mxCell>
        <mxCell id="f1-10" value="&lt;b&gt;5. Đã thanh toán&lt;/b&gt;&lt;br&gt;Quyền dịch vụ PAID_ACTIVE (200/500 MiB, 2/5 suất)&lt;br&gt;Kế hoạch VẪN DRAFT (SETUP-14)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="830" width="340" height="80" as="geometry" />
        </mxCell>
        <mxCell id="f1-11" value="&lt;b&gt;6. Hoàn thiện nội dung&lt;/b&gt;&lt;br&gt;Tạo Container, đưa tài sản vào, nhập người nhận&lt;br&gt;(CCCD 12 số, họ tên, ngày sinh)&lt;br&gt;→ Container đủ cả hai tự chuyển READY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="950" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="f1-12" value="&lt;b&gt;7. Mời Executor&lt;/b&gt;&lt;br&gt;Executor chính chấp nhận;&lt;br&gt;bắt buộc có dự phòng nếu Executor chính là người nhận (SETUP-10)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="1090" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f1-13" value="&lt;b&gt;8. Chọn lịch điểm danh&lt;/b&gt;&lt;br&gt;Chu kỳ 30/60/90 ngày, chờ 7/14/30 ngày" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="1220" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="f1-14" value="&lt;b&gt;9. Bấm “Kích hoạt kế hoạch”&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="1330" width="340" height="50" as="geometry" />
        </mxCell>
        <mxCell id="f1-15" value="Đủ SETUP-01?&lt;br&gt;(PAID_ACTIVE, eKYC, Executor,&lt;br&gt;≥ 1 Container READY,&lt;br&gt;không vượt quota)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="1420" width="280" height="130" as="geometry" />
        </mxCell>
        <mxCell id="f1-16" value="Giữ DRAFT;&lt;br&gt;chỉ rõ mục còn thiếu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="1455" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f1-17" value="Kế hoạch ACTIVE&lt;br&gt;+ một kỳ điểm danh cho toàn kho" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="1600" width="260" height="80" as="geometry" />
        </mxCell>
