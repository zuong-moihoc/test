 target="tk-32"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="tk-61" value="false" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="tk-31" target="tk-33"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="tk-62" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="tk-32" target="tk-34"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="tk-63" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="tk-33" target="tk-34"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="tk-64" value="&lt;b&gt;Chú thích&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1200" y="1640" width="200" height="24" as="geometry" /></mxCell><mxCell id="tk-65" value="Xử lý" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="1670" width="200" height="36" as="geometry" /></mxCell><mxCell id="tk-66" value="Điều kiện" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1200" y="1714" width="200" height="36" as="geometry" /></mxCell><mxCell id="tk-67" value="Truy cập DB" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1200" y="1758" width="200" height="36" as="geometry" /></mxCell><mxCell id="tk-68" value="Kết quả thành công" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1200" y="1802" width="200" height="36" as="geometry" /></mxCell><mxCell id="tk-69" value="Lỗi trả về FE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1200" y="1846" width="200" height="36" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="2. F1 tổng thể (SRS v3.14.1)" id="f1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="2000" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="f1-1" value="F1 — Từ tạo kho đến kích hoạt kế hoạch (SRS v3.14.1 §5.2)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1000" height="36" as="geometry" /></mxCell><mxCell id="f1-2" value="Màu cho biết mức độ đã có trong code: xanh = đã làm, cam = làm một phần, xám nét đứt = chưa làm. SRS tách ba kết quả: tạo kho ≠ thanh toán ≠ kích hoạt." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1200" height="40" as="geometry" /></mxCell><mxCell id="f1-3" value="Người dùng đăng nhập&lt;br&gt;(email đã xác minh / Google)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="100" width="260" height="70" as="geometry" /></mxCell><mxCell id="f1-4" value="&lt;b&gt;1. “Tạo kho của tôi”&lt;/b&gt;&lt;br&gt;Vault OPEN + quyền dịch vụ FREE 20 MiB + kế hoạch DRAFT&lt;br&gt;(SETUP-12: mỗi Owner một kho)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="300" y="210" width="340" height="80" as="geometry" /></mxCell><mxCell id="f1-5" value="&lt;b&gt;2. Dùng hạng Free&lt;/b&gt;&lt;br&gt;✔ Upload, xem, tải tài sản trong 20 MiB&lt;br&gt;✘ Tạo Container rỗng (SETUP-17)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="300" y="330" width="340" height="80" as="geometry" /></mxCell><mxCell id="f1-6" value="&lt;b&gt;3. “Thiết lập bàn giao”&lt;/b&gt;&lt;br&gt;Đồng ý xử lý dữ liệu + eKYC OWNER_ENROLLMENT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;dashed=1;" vertex="1" parent="1"><mxGeometry x="300" y="450" width="340" height="70" as="geometry" /></mxCell><mxCell id="f1-7" value="eKYC đạt&lt;br&gt;(còn trong 90 ngày,&lt;br&gt;EKYC-28)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;" vertex="1" parent="1"><mxGeometry x="350" y="560" width="240" height="110" as="geometry" /></mxCell><mxCell id="f1-8" value="Giữ kho Free;&lt;br&gt;thử lại hoặc nhận hỗ trợ&lt;br&gt;(không ai duyệt thay)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;dashed=1;" vertex="1" parent="1"><mxGeometry x="720" y="580" width="240" height="70" as="geometry" /></mxCell><mxCell id="f1-9" value="&lt;b&gt;4. Mua dịch vụ&lt;/b&gt;&lt;br&gt;Chọn XS / XS Max, kỳ 1/3/5 năm, số suất thêm&lt;br&gt;→ đơn PENDING → QR SePay → webhook" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;dashed=1;" vertex="1" parent="1"><mxGeometry x="300" y="710" width="340" height="80" as="geometry" /></mxCell><mxCell id="f1-10" value="&lt;b&gt;5. Đã thanh toán&lt;/b&gt;&lt;br&gt;Quyền dịch vụ PAID_ACTIVE (200/500 MiB, 2/5 suất)&lt;br&gt;Kế hoạch VẪN DRAFT (SETUP-14)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;dashed=1;" vertex="1" parent="1"><mxGeometry x="300" y="830" width="340" height="80" as="geometry" /></mxCell><mxCell id="f1-11" value="&lt;b&gt;6. Hoàn thiện nội dung&lt;/b&gt;&lt;br&gt;Tạo Container, đưa tài sản vào, nhập người nhận&lt;br&gt;(CCCD 12 số, họ tên, ngày sinh)&lt;br&gt;→ Container đủ cả hai tự chuyển READY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;dashed=1;" vertex="1" parent="1"><mxGeometry x="300" y="950" width="340" height="100" as="geometry" /></mxCell><mxCell id="f1-12" value="&lt;b&gt;7. Mời Executor&lt;/b&gt;&lt;br&gt;Executor chính chấp nhận;&lt;br&gt;bắt buộc có dự phòng nếu Executor chính là người nhận (SETUP-10)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;dashed=1;" vertex="1" parent="1"><mxGeometry x="300" y="1090" width="340" height="90" as="geometry" /></mxCell><mxCell id="f1-13" value="&lt;b&gt;8. Chọn lịch điểm danh&lt;/b&gt;&lt;br&gt;Chu kỳ 30/60/90 ngày, chờ 7/14/30 ngày" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;dashed=1;" vertex="1" parent="1"><mxGeometry x="300" y="1220" width="340" height="70" as="geometry" /></mxCell><mxCell id="f1-14" value="&lt;b&gt;9. Bấm “Kích hoạt kế hoạch”&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;dashed=1;" vertex="1" parent="1"><mxGeometry x="300" y="1330" width="340" height="50" as="geometry" /></mxCell><mxCell id="f1-15" value="Đủ SETUP-01?&lt;br&gt;(PAID_ACTIVE, eKYC, Executor,&lt;br&gt;≥ 1 Container READY,&lt;br&gt;không vượt quota)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;" vertex="1" parent="1"><mxGeometry x="330" y="1420" width="280" height="130" as="geometry" /></mxCell><mxCell id="f1-16" value="Giữ DRAFT;&lt;br&gt;chỉ rõ mục còn thiếu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;dashed=1;" vertex="1" parent="1"><mxGeometry x="720" y="1455" width="240" height="60" as="geometry" /></mxCell><mxCell id="f1-17" value="Kế hoạch ACTIVE&lt;br&gt;+ một kỳ điểm danh cho toàn kho" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="1600" width="260" height="80" as="geometry" /></mxCell><mxCell id="f1-18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="f1-3" target="f1-4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f1-19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="f1-4" target="f1-5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f1-20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="f1-5" target="f1-6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f1-21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="f1-6" target="f1-7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f1-22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="f1-9" target="f1-10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f1-23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="f1-10" target="f1-11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f1-24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="f1-11" target="f1-12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f1-25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="f1-12" target="f1-13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f1-26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="f1-13" target="f1-14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f1-27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="f1-14" target="f1-15"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f1-28" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="f1-7" target="f1-8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f1-29" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="f1-7" target="f1-9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f1-30" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="f1-15" target="f1-16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f1-31" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="f1-15" target="f1-17"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f1-32" value="Bổ sung rồi thử lại" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;" edge="1" parent="1" source="f1-16" target="f1-11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f1-33" value="&lt;b&gt;Vị trí trong code hiện tại&lt;/b&gt;&lt;br&gt;• Bước 1: VaultService.OpenOrCreateMyVaultAsync&lt;br&gt;• Bước 2: AssetService.CreateAssetAsync (đã kiểm tra quota 20 MiB)&lt;br&gt;• Kế hoạch: bảng HandoverPlans (mới có trạng thái DRAFT)&lt;br&gt;• Quyền dịch vụ: bảng VaultEntitlements (mới có FREE)&lt;br&gt;• Bước 3–9: chưa có module" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#bfa94a;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="210" width="250" height="200" as="geometry" /></mxCell><mxCell id="f1-34" value="&lt;b&gt;Chú thích&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="460" width="200" height="24" as="geometry" /></mxCell><mxCell id="f1-35" value="Đã làm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="20" y="490" width="200" height="36" as="geometry" /></mxCell><mxCell id="f1-36" value="Làm một phần" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="20" y="534" width="200" height="36" as="geometry" /></mxCell><mxCell id="f1-37" value="Chưa làm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="578" width="200" height="36" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="3. Thêm tài sản" id="ts"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="2000" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="ts-1" value="Luồng thêm tài sản — POST /api/v1/vaults/{vaultId}/assets" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1000" height="36" as="geometry" /></mxCell><mxCell id="ts-2" value="AssetService.CreateAssetAsync. Căn cứ SETUP-05, SETUP-18, OPLAN-01, NFR-07, NFR-14, QUOTA-02, SEC-02, SEC-03." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1200" height="30" as="geometry" /></mxCell><mxCell id="ts-3" value="Owner gửi tệp&lt;br&gt;(multipart: name, description?, file)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="100" width="280" height="70" as="geometry" /></mxCell><mxCell id="ts-4" value="Kho tồn tại và&lt;br&gt;là của mình?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="360" y="210" width="280" height="100" as="geometry" /></mxCell><mxCell id="ts-5" value="404 VAULT_NOT_FOUND" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="230" width="240" height="60" as="geometry" /></mxCell><mxCell id="ts-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="ts-3" target="ts-4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ts-7" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="ts-4" target="ts-5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ts-8" value="Kho đang OPEN?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="360" y="350" width="280" height="100" as="geometry" /></mxCell><mxCell id="ts-9" value="409 VAULT_NOT_EDITABLE&lt;br&gt;reason = VAULT_CLOSED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="370" width="240" height="60" as="geometry" /></mxCell><mxCell id="ts-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="ts-4" target="ts-8"><mxGeometry relative="