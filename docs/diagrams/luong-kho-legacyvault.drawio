<mxfile host="app.diagrams.net" agent="LegacyVault" version="24.7.17"><diagram name="1. Tạo kho (chi tiết)" id="tk"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="2000" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="tk-1" value="Luồng “Tạo kho của tôi” — POST /api/v1/vaults" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="36" as="geometry" /></mxCell><mxCell id="tk-2" value="Theo code hiện tại, căn cứ SRS v3.14.1 §5.2 bước 1, SETUP-12, SETUP-18, AUTH-04, AC-01, AC-89, AC-104. Kết quả luôn là MỘT kho cho mỗi Owner: Vault OPEN + kế hoạch DRAFT + quyền dịch vụ FREE 20 MiB." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1440" height="40" as="geometry" /></mxCell><mxCell id="tk-3" value="Người dùng / Frontend" style="swimlane;whiteSpace=wrap;html=1;startSize=36;fillColor=#eef3f8;strokeColor=#8aa2bd;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="240" height="1900" as="geometry" /></mxCell><mxCell id="tk-4" value="API · VaultsController" style="swimlane;whiteSpace=wrap;html=1;startSize=36;fillColor=#eef3f8;strokeColor=#8aa2bd;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="260" y="100" width="400" height="1900" as="geometry" /></mxCell><mxCell id="tk-5" value="VaultService (nghiệp vụ)" style="swimlane;whiteSpace=wrap;html=1;startSize=36;fillColor=#eef3f8;strokeColor=#8aa2bd;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="660" y="100" width="500" height="1900" as="geometry" /></mxCell><mxCell id="tk-6" value="VaultRepository · SQL Server" style="swimlane;whiteSpace=wrap;html=1;startSize=36;fillColor=#eef3f8;strokeColor=#8aa2bd;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1160" y="100" width="360" height="1900" as="geometry" /></mxCell><mxCell id="tk-7" value="Owner bấm&lt;br&gt;“Tạo kho của tôi”" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="160" width="180" height="70" as="geometry" /></mxCell><mxCell id="tk-8" value="Gửi POST /api/v1/vaults&lt;br&gt;body tùy chọn:&lt;br&gt;{ name?, description? }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="270" width="180" height="80" as="geometry" /></mxCell><mxCell id="tk-9" value="Mọi lỗi trả JSON ProblemDetails có trường &lt;b&gt;code&lt;/b&gt; (ví dụ EMAIL_NOT_VERIFIED). FE hiển thị thông báo theo code." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#bfa94a;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="200" height="110" as="geometry" /></mxCell><mxCell id="tk-10" value="Access token&lt;br&gt;hợp lệ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="290" y="165" width="170" height="90" as="geometry" /></mxCell><mxCell id="tk-11" value="401&lt;br&gt;Chưa đăng nhập" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="180" width="150" height="60" as="geometry" /></mxCell><mxCell id="tk-12" value="Role = OWNER?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="290" y="290" width="170" height="90" as="geometry" /></mxCell><mxCell id="tk-13" value="403 Forbidden&lt;br&gt;(Admin/Verifier không có kho)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="305" width="150" height="60" as="geometry" /></mxCell><mxCell id="tk-14" value="Body hợp lệ?&lt;br&gt;name ≤ 200,&lt;br&gt;mô tả ≤ 1000" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="290" y="415" width="170" height="100" as="geometry" /></mxCell><mxCell id="tk-15" value="400&lt;br&gt;VALIDATION_ERROR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="435" width="150" height="60" as="geometry" /></mxCell><mxCell id="tk-16" value="Lấy userId từ JWT&lt;br&gt;(RequireUserId)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="690" y="560" width="220" height="60" as="geometry" /></mxCell><mxCell id="tk-17" value="Tài khoản tồn tại&lt;br&gt;và Status = Active?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="690" y="660" width="220" height="100" as="geometry" /></mxCell><mxCell id="tk-18" value="403&lt;br&gt;ACCOUNT_NOT_ACTIVE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="950" y="680" width="190" height="60" as="geometry" /></mxCell><mxCell id="tk-19" value="Email đã xác minh?&lt;br&gt;(AUTH-04, AC-01)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="690" y="800" width="220" height="100" as="geometry" /></mxCell><mxCell id="tk-20" value="403 EMAIL_NOT_VERIFIED&lt;br&gt;Không tạo kho" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="950" y="820" width="190" height="60" as="geometry" /></mxCell><mxCell id="tk-21" value="Tìm kho theo OwnerId&lt;br&gt;(kèm kế hoạch và quyền dịch vụ)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1200" y="930" width="280" height="70" as="geometry" /></mxCell><mxCell id="tk-22" value="Owner đã có kho?&lt;br&gt;(kể cả kho CLOSED)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="690" y="1040" width="220" height="100" as="geometry" /></mxCell><mxCell id="tk-23" value="Mở lại kho cũ&lt;br&gt;Created = false&lt;br&gt;(SETUP-12, AC-104)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="950" y="1130" width="190" height="80" as="geometry" /></mxCell><mxCell id="tk-24" value="Tạo đối tượng mới:&lt;br&gt;• Vault OPEN, tên mặc định “Kho của tôi”&lt;br&gt;• Kế hoạch DRAFT, config_version = 1&lt;br&gt;• Quyền dịch vụ FREE: 20 MiB, 0 suất" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="1190" width="240" height="110" as="geometry" /></mxCell><mxCell id="tk-25" value="INSERT Vaults + HandoverPlans&lt;br&gt;+ VaultEntitlements&lt;br&gt;trong MỘT transaction" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1200" y="1200" width="280" height="90" as="geometry" /></mxCell><mxCell id="tk-26" value="Unique index&lt;br&gt;UX_Vaults_OwnerId&lt;br&gt;báo trùng?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1230" y="1330" width="220" height="110" as="geometry" /></mxCell><mxCell id="tk-27" value="Bỏ theo dõi bản ghi hỏng;&lt;br&gt;đọc lại kho của request&lt;br&gt;vừa tạo trước (hai tab, retry)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1200" y="1490" width="280" height="90" as="geometry" /></mxCell><mxCell id="tk-28" value="Kho mới&lt;br&gt;Created = true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="690" y="1355" width="200" height="60" as="geometry" /></mxCell><mxCell id="tk-29" value="Trả kho request kia&lt;br&gt;vừa tạo, Created = false&lt;br&gt;(AC-89)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="930" y="1500" width="200" height="70" as="geometry" /></mxCell><mxCell id="tk-30" value="Đếm tài sản + dung lượng đã dùng&lt;br&gt;→ VaultResponse" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="1620" width="260" height="60" as="geometry" /></mxCell><mxCell id="tk-31" value="Created?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="340" y="1605" width="140" height="90" as="geometry" /></mxCell><mxCell id="tk-32" value="201 Created&lt;br&gt;+ Location: /vaults/{id}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="280" y="1740" width="170" height="60" as="geometry" /></mxCell><mxCell id="tk-33" value="200 OK&lt;br&gt;(mở lại kho cũ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="470" y="1740" width="160" height="60" as="geometry" /></mxCell><mxCell id="tk-34" value="FE hiển thị kho:&lt;br&gt;OPEN · DRAFT · FREE&lt;br&gt;đã dùng / 20 MiB" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1730" width="200" height="90" as="geometry" /></mxCell><mxCell id="tk-35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="tk-7" target="tk-8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="tk-36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;ort